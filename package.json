{
  "name": "jk-bms-monitor",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop JK BMS Bluetooth LE monitor",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test protocol.test.mjs flow-periods.test.mjs voltage-chart-data.test.mjs discharge-forecast.test.mjs",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:linux": "electron-builder --linux AppImage --publish never"
  },
  "devDependencies": {
    "electron": "45.3.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.jkbms.monitor",
    "productName": "JK BMS Monitor",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "styles.css",
      "app.mjs",
      "discharge-forecast.mjs",
      "flow-periods.mjs",
      "voltage-chart-data.mjs",
      "protocol.mjs",
      "electron/**/*",
      "README.md"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": "dmg",
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "Потрібно для підключення до JK BMS та зчитування телеметрії.",
        "NSBluetoothPeripheralUsageDescription": "Потрібно для підключення до JK BMS та зчитування телеметрії."
      }
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
